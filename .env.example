# Banco (Neon). Pooled para a app; unpooled (sem "-pooler") para migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Mídia
BLOB_READ_WRITE_TOKEN=
# Bootstrap do owner (só no momento do bootstrap; não deixar na Vercel depois)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# E-mail: console (dev) | resend (prod)
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=
# Proteção de seed/reset: só "dev" libera
SEED_TARGET=
# Testes de banco (base VAZIA local)
TEST_DATABASE_URL=
